[
  {
    "name": "adding a habit guides a user through title, schedule, and time",
    "steps": [
      {
        "expect": [
          {
            "method": "editMessageText"
          }
        ],
        "send": {
          "callback": "habit:new"
        }
      },
      {
        "send": { "text": "Read" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Choose a rhythm that feels realistic." } }]
      },
      {
        "send": { "callback": "habit:schedule:daily" },
        "expect": [{ "method": "editMessageText" }]
      },
      {
        "send": { "text": "08:30" },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "callback": "checkin:done:1" },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "send": { "callback": "checkin:done:1" },
        "expect": [{ "method": "sendMessage" }]
      }
    ]
  }
]
